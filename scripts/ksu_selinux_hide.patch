+static void ksu_apply_selinux_hide_spoof(struct av_decision *avd, const char *scon, const char *tcon, u16 tclass)
+{
+    static const struct {
+        const char *src_substr;
+        const char *dst_substr;
+        u32 mask;
+    } rules[] = {
+        { "fsck_untrusted", "fsck_untrusted", 0x00200000 },
+        { "adbd", "adbroot", 0x00000002 },
+    };
+
+    if (!avd || !scon || !tcon)
+        return;
+
+    size_t i;
+    for (i = 0; i < sizeof(rules) / sizeof(rules[0]); i++) {
+        if (strstr(scon, rules[i].src_substr) && strstr(tcon, rules[i].dst_substr)) {
+            avd->allowed &= ~rules[i].mask;
+        }
+    }
+
+    /* Hide AOSP su detection from DirtySepolicy by denying shell->su process transition. */
+    if (tclass == SECCLASS_PROCESS && strcmp(scon, "u:r:shell:s0") == 0 && strcmp(tcon, "u:r:su:s0") == 0) {
+        avd->allowed = 0;
+    }
+}
